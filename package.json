{
  "name": "chtc-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/reset-remote-images.mjs",
    "build": "next build",
    "postbuild": "node scripts/validate-remote-images.mjs && next-image-export-optimizer && next-sitemap && tsx scripts/generate-redirects.mjs && pagefind --site out && node scripts/llms-full.mjs",
    "start": "next start",
    "lint": "eslint .",
    "analyze": "ANALYZE=true next build",
    "compare:migration": "tsx scripts/compare-migration.mjs",
    "unlighthouse:live": "unlighthouse --config-file unlighthouse.config.ts"
  },
  "dependencies": {
    "@chtc/web-components": "^2.0.11",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@next/bundle-analyzer": "^15.5.28",
    "@next/mdx": "^16.4.2",
    "@socialgouv/matomo-next": "^1.14.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "js-yaml": "^5.5.0",
    "next": "^16.4.2",
    "next-image-export-optimizer": "^1.20.1",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.4.6",
    "node-html-parser": "^9.0.5",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "unlighthouse": "^0.19.1"
  }
}
